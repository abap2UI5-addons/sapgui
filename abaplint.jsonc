{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      // A release tag, not main: users install a release next to this addon
      // (abap2UI5 CONVENTIONS §9). scripts/core-pin.mjs reads and moves it in
      // every abaplint config at once, bump-core moves it weekly after the gates
      // passed on the new tag, and the weekly canary run lints once against main.
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "1.146.0",
      "folder": "/deps/abap2ui5",
      "files": "/src/**/*.*"
    },
    {
      // abap-cloud-gui: the report runtime the pilot ZCL_SAPGUI_SM37_CGUI
      // inherits from - its src/01, not the samples
      "url": "https://github.com/abap2UI5-addons/abap-cloud-gui",
      "branch": "main",
      "folder": "/deps/abap-cloud-gui",
      "files": "/src/01/**/*.*"
    },
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps/steampunk",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "^(Z|Y)",
    // constants of type pools that the dependencies above do not carry
    "globalConstants": [
      "seok_access_modify"
    ]
  },
  "rules": {
    "7bit_ascii": true,
    "add_test_attributes": true,
    "aff_and_xml": true,
    "allowed_object_naming": true,
    "allowed_object_types": {
      "allowed": [
        "CLAS",
        "DEVC",
        "INTF",
        "MSAG",
        "TABL"
      ]
    },
    "ambiguous_statement": true,
    "avoid_use": {
      "define": true,
      "statics": true,
      "defaultKey": true,
      "break": true,
      "testSeams": true,
      "describeLines": true,
      "exportToMemory": true,
      "exportToDatabase": true
    },
    "begin_end_names": true,
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": true,
    "cds_association_name": true,
    "cds_field_order": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "check_abstract": true,
    "check_comments": {
      "allowEndOfLine": true
    },
    "check_ddic": true,
    "check_include": true,
    // SELECT ... INTO TABLE is always followed by a LOOP or an IS INITIAL
    // check here, and ASSIGN is always followed by IS ASSIGNED
    "check_subrc": {
      "openDataset": true,
      "authorityCheck": true,
      "selectSingle": true,
      "selectTable": false,
      "updateDatabase": true,
      "insertDatabase": true,
      "modifyDatabase": true,
      "deleteDatabase": true,
      "readTable": true,
      "assign": false,
      "find": true
    },
    "check_syntax": true,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": true,
    "colon_missing_space": true,
    "constant_classes": true,
    "constructor_visibility_public": true,
    "contains_tab": true,
    // This repository rebuilds the ABAP Workbench, so INSERT REPORT (SE38 /
    // SE80 source save) and dynamic SQL (SE16N table browser) are the
    // feature, not an accident. Everything else stays forbidden.
    "dangerous_statement": {
      "insertTextpool": true,
      "execSQL": true,
      "kernelCall": true,
      "systemCall": true,
      "insertReport": false,
      "generateDynpro": true,
      "generateReport": true,
      "generateSubroutine": true,
      "deleteReport": true,
      "deleteTextpool": true,
      "deleteDynpro": true,
      "exportDynpro": true,
      "editorCallForReport": true,
      "dynamicSQL": false
    },
    "description_empty": true,
    "double_space": false,
    "downport": true,
    "dynpro_checks": true,
    "else_after_all_returns": true,
    "empty_event": true,
    "empty_statement": true,
    "empty_structure": {
      "loop": false,
      "if": true,
      "while": true,
      "case": true,
      "select": true,
      "do": true,
      "at": true,
      "try": true,
      "when": false
    },
    "exit_or_check": true,
    "expand_macros": true,
    "exporting": true,
    "fm_global_parameters_obsolete": true,
    "forbidden_identifier": true,
    "forbidden_pseudo_and_pragma": {
      "exclude": [],
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "pragmas": [],
      "pseudo": [],
      "severity": "Error"
    },
    "forbidden_void_type": {
      "check": [
        "^boole_d$",
        "^char10$",
        "^char12$",
        "^char2$",
        "^char20$",
        "^char30$",
        "^char4$",
        "^char50$",
        "^char70$",
        "^cl_abap_syst",
        "^cl_aff_",
        "^cl_aucv_test_runner_abstract$",
        "^cl_aucv_test_runner_standard$",
        "^cl_aunit_assert$",
        "^cl_axt_dbtable$",
        "^cl_blue_wb_utility$",
        "^cl_oo_source$",
        "^/ui2/cl_",
        "^cl_saunit_internal_result$",
        "^cl_srvd_wb_object_data$",
        "^cl_wb_object_operator_factory$",
        "^cl_wer_const$",
        "^cl_xco_",
        "^cx_aff_",
        "^cx_wb_object_operation_error$",
        "^cx_xco_",
        "^flag$",
        "^i18_a_langiso2$",
        "^if_adt_lock_handle$",
        "^if_aff_",
        "^if_satc_ci_variant_access$",
        "^if_saunit_internal_result$",
        "^if_saunit_internal_result_type$",
        "^if_srvd_types$",
        "^if_wb_adt_plugin_resource_co$",
        "^if_wb_object_data_selection_co$",
        "^if_wb_object_operator$",
        "^if_xco_",
        "^int4$",
        "^numc2$",
        "^sabp_t_tadir_keys$",
        "^sap_bool$",
        "^srcsystem$",
        "^stringtab$",
        "^sychar01$",
        "^sychar10$",
        "^sychar70$",
        "^sydatum$",
        "^sylangu$",
        "^syst_title$",
        "^syuzeit$",
        "^feld$",
        "^abap_boolean$"
      ],
      "exclude": []
    },
    "form_tables_obsolete": true,
    "fully_type_constants": {
      "checkData": true
    },
    "fully_type_itabs": true,
    "functional_writing": {
      "ignoreExceptions": true
    },
    "global_class": true,
    "identical_conditions": true,
    "identical_descriptions": true,
    "identical_form_names": true,
    "identical_move": true,
    "implement_methods": true,
    "implicit_start_of_selection": true,
    "index_completely_contained": true,
    "inline_data_old_versions": true,
    "invalid_table_index": true,
    "keyword_case": false,
    "line_break_style": true,
    "line_length": false,
    "local_testclass_consistency": true,
    "macro_naming": true,
    "main_file_contents": true,
    "max_one_method_parameter_per_line": true,
    "max_one_statement": true,
    "message_exists": true,
    "method_implemented_twice": true,
    "method_overwrites_builtin": true,
    "mix_returning": true,
    "modify_only_own_db_tables": {
      "reportDynamic": true,
      "ownTables": "^[yz]"
    },
    "msag_consistency": true,
    "names_no_dash": true,
    "nesting": {
      "depth": 6
    },
    "newline_between_methods": true,
    "no_aliases": true,
    "no_chained_assignment": true,
    "no_external_form_calls": true,
    "no_yoda_conditions": {
      "onlyConstants": true
    },
    "nrob_consistency": true,
    "object_naming": {
      "patternKind": "required",
      "clas": "^Z",
      "intf": "^Z",
      "prog": "^Z",
      "fugr": "^Z",
      "tabl": "^Z",
      "ttyp": "^Z",
      "dtel": "^Z",
      "doma": "^Z",
      "msag": "^Z",
      "tran": "^Z",
      "enqu": "^EZ",
      "auth": "^Z",
      "pinf": "^Z",
      "idoc": "^Z",
      "xslt": "^Z",
      "ssfo": "^Z",
      "ssst": "^Z",
      "shlp": "^Z"
    },
    "obsolete_statement": true,
    "omit_parameter_name": true,
    "omit_preceding_zeros": true,
    "omit_receiving": true,
    "parser_702_chaining": true,
    "parser_bad_exceptions": true,
    "parser_error": true,
    "parser_missing_space": true,
    "pragma_style": true,
    "prefer_abap_bool_values": true,
    "prefer_is_not": true,
    "prefer_pragmas": true,
    "prefer_raise_exception_new": true,
    "prefer_returning_to_exporting": true,
    "prefer_xsdbool": true,
    "preferred_compare_operator": true,
    "preferred_parameter_ignored": true,
    "prefix_is_current_class": {
      "exclude": [],
      "severity": "Warning"
    },
    "reduce_procedural_code": true,
    "reduce_string_templates": true,
    "redundant_conversion": true,
    "release_idoc": true,
    "remove_descriptions": {
      "ignoreExceptions": false,
      "ignoreWorkflow": false
    },
    "rfc_error_handling": true,
    // the table browsers select from a table name only known at runtime,
    // so neither a column list nor a static ORDER BY is possible
    "select_add_order_by": false,
    "select_performance": {
      "endSelect": true,
      "selectStar": false
    },
    "selection_screen_naming": true,
    "sequential_blank": {
      "exclude": [],
      "severity": "Warning"
    },
    "short_case": true,
    "sicf_consistency": true,
    "slow_parameter_passing": true,
    "space_before_colon": true,
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "static_call_via_instance": true,
    "strict_sql": true,
    "superclass_final": true,
    "superfluous_value": true,
    "sy_modification": true,
    "tabl_enhancement_category": true,
    "tables_declared_locally": true,
    "try_without_catch": true,
    "type_form_parameters": true,
    "uncaught_exception": true,
    "unknown_types": true,
    "unnecessary_chaining": true,
    "unnecessary_loop_guard": true,
    "unnecessary_pragma": true,
    "unnecessary_return": true,
    "unreachable_code": true,
    // the rule reports every FOR ALL ENTRIES, guarded or not (its own
    // implementation says "todo"); each of the three here sits behind an
    // IS NOT INITIAL check of its driver table
    "unsecure_fae": false,
    "unused_ddic": true,
    "unused_macros": true,
    "unused_methods": true,
    "unused_types": true,
    "unused_variables": {
      "severity": "Error",
      "skipNames": [
        "lv_dummy",
        "<dummy>"
      ]
    },
    "use_bool_expression": true,
    "use_class_based_exceptions": true,
    "use_line_exists": true,
    "use_message_class": true,
    "use_new": true,
    "when_others_last": true,
    "whitespace_end": true,
    "wrong_abapdoc_position": true,
    "xml_bom": true,
    "xml_consistency": true
  }
}
